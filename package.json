{
  "name": "barvion-group-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "echo \"statik site: build gerekmez\"",
    "site:build": "node build.mjs",
    "premium:dev": "vite --config premium/vite.config.ts --host 127.0.0.1",
    "premium:build": "tsc -p premium/tsconfig.json && vite build --config premium/vite.config.ts",
    "premium:preview": "vite preview --config premium/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc -p premium/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}